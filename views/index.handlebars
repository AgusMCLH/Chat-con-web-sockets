<section id='container'>

  <!-- Header -->
  <div id='title'>
    <div class='header-icon'>
      <svg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'>
        <path
          d='M20 2H4C2.9 2 2 2.9 2 4v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z'
        />
      </svg>
    </div>
    <div class='header-text'>
      <h1>Chat en vivo</h1>
      <p>Socket.io · Tiempo real</p>
    </div>
    <div class='status-dot' title='Conectado'></div>
  </div>

  <!-- Message history -->
  <div id='history'></div>

  <!-- Input -->
  <div id='msg__container'>
    <div class='input-wrapper'>
      <input type='text' id='msg' placeholder='Escribe un mensaje…' autocomplete='off' />
      <button class='send-btn' id='send-btn' title='Enviar (Enter)'>
        <svg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'>
          <path d='M2.01 21L23 12 2.01 3 2 10l15 2-15 2z' />
        </svg>
      </button>
    </div>
    <p class='input-hint'>Presiona
      <kbd
        style='color:#fff;background:#2a2a3a;padding:1px 5px;border-radius:4px;font-size:10px;'
      >Enter</kbd>
      para enviar</p>
  </div>

</section>

<script src='/socket.io/socket.io.js'></script>
<script src='https://cdn.jsdelivr.net/npm/sweetalert2@11.7.5/dist/sweetalert2.all.min.js'></script>
<script src='/js/main.js'></script>